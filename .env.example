# Dachapgo (optional) — local browser API server
DACHAPGO_BASE_URL=http://127.0.0.1:50330
DACHAPGO_API_KEY=
DACHAPGO_DATA_DIR=
# Comma separated "serial:user_id" pairs of your Google profiles
DACHAPGO_GOOGLE_PROFILES=
DACHAPGO_DEFAULT_PROFILE=
GFLOW_DACHAPGO_FOREGROUND=0
GFLOW_DACHAPGO_CLOSE_ON_DONE=1

# Account rotation (gflow rotate ...)
# Comma separated gflow profile names (from `gflow auth list`), e.g. acct1,acct2,...
GFLOW_ROTATE_PROFILES=acct1,acct2,acct3,acct4,acct5,acct6
GFLOW_ROTATE_STATE_DIR=
GFLOW_ROTATE_CREDITS_TTL=1800
GFLOW_ROTATE_DELAY=5
GFLOW_ROTATE_JITTER=3
GFLOW_ROTATE_MIN_CREDITS=0
GFLOW_ROTATE_MAX_ATTEMPTS=
